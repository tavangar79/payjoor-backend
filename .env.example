# Copy to .env and fill in. Never commit real values (PRD §12).

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
# true behind one trusted reverse proxy (login lockout uses the client IP)
TRUST_PROXY=false
CONTACT_EMAIL=
# Website: the bot's Instagram handle (without @) and the company named in the privacy policy (§7.3)
SITE_INSTAGRAM_HANDLE=
COMPANY_NAME=

# Data
MONGODB_URI=mongodb://localhost:27017/pagesanj
# Must use maxmemory-policy noeviction (BullMQ requirement)
REDIS_URL=redis://localhost:6379

# Debugging only: keep incoming message text in dmEvents
DM_STORE_TEXT=false

# BoxAPI (boxapi.ir), see .claude/skills/boxapi. Hosted outside Iran: Data API host is instagram.boxpi.ir.
# DM & Comment API key (header X-Api-Key)
BOXAPI_INSTAGRAM_DM_TOKEN=
# Instagram Data API token (Authorization: Bearer)
BOXAPI_INSTAGRAM_TOKEN=
# AI API token (Authorization: Bearer), e.g. for the typesafe/jev-* models
BOXAPI_AI_TOKEN=
# Webhook secret from the BoxAPI panel (API settings); /webhooks/boxapi rejects everything until set
BOXAPI_WEBHOOK_SECRET=

# Apify (§6.2)
APIFY_TOKEN=
APIFY_BUDGET_STOP_USD=4.50
# Shop profile fetch (§5.6)
APIFY_PROFILE_ACTOR=apify~instagram-profile-scraper
# Post scraper: reviewer posts (§6) and post-to-author lookups (§5.3)
APIFY_POST_ACTOR=apify~instagram-post-scraper
# Comma-separated handles tagged in reviewer posts that aren't shops (sponsors etc.)
APIFY_IGNORE_HANDLES=
DAILY_CHECK_CRON=0 9 * * *

# Admin auth (§9.1)
SESSION_SECRET=
# Same value as pagesanj's (base64 of 32 bytes)
DATA_ENCRYPTION_KEY=
# Optional, read-only; only for npm run admin:import
PAGESANJ_MONGODB_URI=
# Only for npm run admin:create
ADMIN_PASSWORD=
