# Copy to .env and fill in. Never commit real values (PRD §12).

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# The website's public URL (web/), for the data-deletion status link
PUBLIC_BASE_URL=http://localhost:3001
# true behind one trusted reverse proxy (login lockout uses the client IP)
TRUST_PROXY=false

# Data
MONGODB_URI=mongodb://localhost:27017/pagesanj
# Must use maxmemory-policy noeviction (BullMQ requirement)
REDIS_URL=redis://localhost:6379

# Debugging only: keep incoming message text in dmEvents
DM_STORE_TEXT=false

# BoxAPI (boxapi.ir), see .claude/skills/boxapi. Hosted outside Iran: Data API host is instagram.boxpi.ir.
# DM & Comment API key (header X-Api-Key)
BOXAPI_INSTAGRAM_DM_TOKEN=
# DM API base URL; defaults to SendBox's host (outside Iran). Iran: https://boxapi.ir
# BOXAPI_DM_BASE_URL=https://api.sendbox.chat/api/v1
# Instagram Data API token (Authorization: Bearer)
BOXAPI_INSTAGRAM_TOKEN=
# AI API token (Authorization: Bearer), e.g. for the typesafe/jev-* models. Host: https://ai.boxapi.ir/ai/v1 (ai.boxpi.ir rejects it).
BOXAPI_AI_TOKEN=
# Webhook secret from the BoxAPI panel (API settings); /webhooks/boxapi rejects everything until set
BOXAPI_WEBHOOK_SECRET=

# Data API host; defaults to instagram.boxpi.ir (outside Iran). Use https://boxapi.ir if your token is rejected there.
# BOXAPI_INSTAGRAM_BASE_URL=https://boxapi.ir

# AI API base URL (default shown) and the model that classifies trusted reviewers' posts
# BOXAPI_AI_BASE_URL=https://ai.boxapi.ir/ai/v1
AI_REVIEW_MODEL=openai/gpt-6-luna
# Minimum AI confidence (0..1) for a classified post to be auto-published
# AI_PUBLISH_MIN_CONFIDENCE=0.8

# Reviewer posts (§6): comma-separated tagged handles that aren't shops (sponsors etc.)
REVIEW_IGNORE_HANDLES=
DAILY_CHECK_CRON=0 9 * * *

# Admin auth (§9.1)
SESSION_SECRET=
# Same value as pagesanj's (base64 of 32 bytes)
DATA_ENCRYPTION_KEY=
# Optional, read-only; only for npm run admin:import
PAGESANJ_MONGODB_URI=
# Only for npm run admin:create
ADMIN_PASSWORD=
# 32+ characters (openssl rand -hex 32). Turns on POST /admin/api/auth/setup until the first admin exists; clear it afterwards
ADMIN_SETUP_TOKEN=
